<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title><%= content_for?(:title) ? yield(:title) : "Document" %></title>
  <style>
    :root{--ink:#1a1a1a;--muted:#666;--line:#e3e3e3;--bg:#fff;--page:#f5f5f3;--ok:#1d7a46;--bad:#a33;--accent:#1f5fbf;--on-accent:#fff}
    @media (prefers-color-scheme:dark){:root{--ink:#eee;--muted:#aaa;--line:#333;--bg:#1b1b1b;--page:#111;--ok:#5fc68b;--bad:#e77;--accent:#7aa7ef;--on-accent:#0b1220}}
    *{box-sizing:border-box}body{margin:0;background:var(--page);color:var(--ink);font:16px/1.5 -apple-system,system-ui,"Segoe UI",sans-serif}
    main{max-width:760px;margin:0 auto;padding:24px 16px 48px}
    .doc{background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:28px 24px}
    h1{font-size:22px;margin:0 0 4px}.muted{color:var(--muted);font-size:14px}
    table{width:100%;border-collapse:collapse;margin:20px 0}th,td{padding:8px 4px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
    td.n,th.n{text-align:right;white-space:nowrap}tfoot td{border:0;padding:4px}tfoot tr.total td{font-weight:700;font-size:18px;border-top:2px solid var(--ink)}
    .banner{padding:10px 14px;border-radius:8px;margin:0 0 16px;font-weight:600}.banner.ok{background:color-mix(in srgb,var(--ok) 15%,transparent);color:var(--ok)}
    .banner.bad{background:color-mix(in srgb,var(--bad) 15%,transparent);color:var(--bad)}.banner.info{background:color-mix(in srgb,var(--accent) 12%,transparent);color:var(--accent)}
    form{margin-top:24px;display:grid;gap:10px}input[type=text]{padding:10px;border:1px solid var(--line);border-radius:8px;font-size:16px;background:transparent;color:var(--ink)}
    button{padding:12px;border:0;border-radius:8px;font-size:16px;font-weight:600;cursor:pointer;background:var(--accent);color:var(--on-accent)}button.secondary{background:transparent;color:var(--muted);border:1px solid var(--line)}
    .body{white-space:pre-wrap;font-size:15px}label.check{display:flex;gap:8px;align-items:flex-start;font-size:14px}
    .sig{margin-top:20px;padding-top:12px;border-top:1px solid var(--line);font-size:14px}
    @media print{body{background:#fff}main{padding:0}.doc{border:0}form,.noprint{display:none}}
  </style>
</head>
<body><main><%= yield %><p class="muted noprint" style="text-align:center;margin-top:16px">Tip: use your browser's Print to save a PDF.</p></main></body>
</html>
